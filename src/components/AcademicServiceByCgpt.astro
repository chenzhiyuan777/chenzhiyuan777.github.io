---
// by cgpt: Render teaching and social practice with the shared Work Experience timeline.
import OrganizationName from "./OrganizationName.astro";
import InlineTextByCgpt from "./InlineTextByCgpt.astro";

// by cgpt: Dates are author-provided; emphasize the two honors without raw HTML.
interface ServiceEntry {
  kind: "teaching" | "social-practice";
  period: string;
  organization: string;
  role: string;
  text: string;
  emphasis: string;
}

// by cgpt: Order academic experiences by their start year, newest first.
const entries: ServiceEntry[] = [
  {
    kind: "social-practice",
    period: "2023",
    organization: "Tsinghua University",
    role: "Social Practice Team Captain",
    text: "The doctoral student social practice team received a university-level Gold Award.",
    emphasis: "Gold Award",
  },
  {
    kind: "teaching",
    period: "2022–2024",
    organization: "Tsinghua University",
    role: "Teaching Assistant",
    // by cgpt: Specify undergraduate courses directly beneath the formal TA role.
    text: "Undergraduate courses: Calculus and UAV Development; recognized as an Outstanding Teaching Assistant.",
    emphasis: "Outstanding Teaching Assistant",
  },
];
---

{entries.map(({ kind, period, organization, role, text, emphasis }) => {
  const [prefix, suffix = ""] = text.split(emphasis);
  return (
    <article class="timeline-item" data-service-by-cgpt={kind}>
      <p class="timeline-period"><InlineTextByCgpt text={period} /></p>
      <div>
        <h3 class="timeline-organization"><OrganizationName name={organization} /></h3>
        <p class="timeline-role"><InlineTextByCgpt text={role} /></p>
        <p><InlineTextByCgpt text={prefix} /><strong>{emphasis}</strong><InlineTextByCgpt text={suffix} /></p>
      </div>
    </article>
  );
})}
