---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
// by cgpt: Person metadata uses the same versioned image as the sidebar.
import { avatarImageByCgpt } from "../data/avatarByCgpt";
import PublicationItem from "../components/PublicationItem.astro";
import OrganizationName from "../components/OrganizationName.astro";
import OrganizationText from "../components/OrganizationText.astro";
// by cgpt: Apply the shared short-phrase rules to news and timeline text as well.
import InlineTextByCgpt from "../components/InlineTextByCgpt.astro";
import { CornerDownRight } from "lucide-astro";
// by cgpt: Verified sections live separately from the shared profile source.
import PatentsSectionByCgpt from "../components/PatentsSectionByCgpt.astro";
import AwardsSectionByCgpt from "../components/AwardsSectionByCgpt.astro";
import {
  education,
  news,
  publications,
  researchProjects,
  workExperience,
} from "../data/profile";

const title = "Zhiyuan";
const description =
  "Zhiyuan Chen is a robotics researcher at Xiaomi and a Ph.D. graduate of Tsinghua University.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Zhiyuan Chen",
  alternateName: "陈志远",
  url: "https://chenzhiyuan777.github.io/",
  // by cgpt: Keep Person metadata aligned with the approved visible avatar.
  image: new URL(avatarImageByCgpt, "https://chenzhiyuan777.github.io/").href,
  email: "mailto:chenzy19@tsinghua.edu.cn",
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Tsinghua University",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Wuhan University of Science and Technology",
    },
  ],
  worksFor: {
    "@type": "Organization",
    name: "Xiaomi",
  },
};
---

<BaseLayout title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />

  <main class="page-shell">
    <ProfileSidebar />

    <div class="content-column">
      <section id="about-me" class="intro-section" aria-labelledby="about-title">
        <h1 id="about-title">About Me</h1>
        <p class="intro-lead">
          <OrganizationText
            text="I am a robotics researcher at Xiaomi, working on embodied intelligence and learning-based robotic manipulation. I received my Ph.D. in Mechanical Engineering from Tsinghua University in 2025."
            size={22}
            emphasize
          />
        </p>
        <p>
          My research focuses on <strong>embodied intelligence</strong>, <strong>generalizable robot learning</strong>, and <strong>end-to-end manipulation policies</strong> for real-world tasks. I am particularly interested in <strong>vision-language-action (VLA) models</strong> and <strong>world-action models (WAMs)</strong>, leveraging visual, tactile, and human-demonstration data to learn robust robot behaviors. My work spans vision- and touch-guided manipulation, including reactive tactile control and predictive contact-aware modeling.
        </p>
        <p>
          <OrganizationText text="Previously, my research at Tsinghua University and Huawei focused on vision-guided robotic assembly." />{" "}
          I also have hands-on experience in <strong>real-world robotic system development</strong>, spanning robot perception, visual servoing, motion planning, and system integration.
        </p>

        <div id="-news" class="news-block" aria-labelledby="news-title">
          <div class="section-kicker">
            <h2 id="news-title">🔥 News</h2>
          </div>
          <ol class="news-list">
            {
              news.map((item) => (
                <li>
                  <time datetime={item.date}>{item.date}</time>
                  <p>
                    {item.icon === "trophy" && (
                      <span class="news-award-icon" role="img" aria-label="First place trophy">🏆</span>
                    )}
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.textHtml ? (
                          <InlineTextByCgpt text={item.textHtml} html />
                        ) : (
                          <OrganizationText text={item.text} />
                        )}
                      </a>
                    ) : (
                      item.textHtml ? (
                        <InlineTextByCgpt text={item.textHtml} html />
                      ) : (
                        <OrganizationText text={item.text} />
                      )
                    )}
                    {item.jumpHref && (
                      <a
                        class="news-jump"
                        href={item.jumpHref}
                        aria-label={item.jumpLabel}
                        title={item.jumpLabel}
                      >
                        <CornerDownRight size={16} strokeWidth={1.8} aria-hidden="true" />
                      </a>
                    )}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section id="publications" class="content-section" aria-labelledby="publications-title">
        <div class="section-heading">
          <div>
            <h2 id="publications-title">📝 Publications</h2>
          </div>
        </div>

        <div class="publication-list">
          {
            publications.map((publication) => (
              <PublicationItem publication={publication} />
            ))
          }
        </div>
      </section>

      <PatentsSectionByCgpt />

      <AwardsSectionByCgpt kind="competitions" />

      <section id="research-and-projects" class="content-section" aria-labelledby="research-title">
        <div class="section-heading compact">
          <div><h2 id="research-title">🔍 Research and Projects</h2></div>
        </div>
        <div class="research-project-list">
          {researchProjects.map((project) => (
            <article class="research-project">
              <div class="research-project-title">
                <span class="project-badge">{project.type}</span>
                <h3><img src={project.logo} alt={`${project.organization} logo`} width="20" height="20" /> <InlineTextByCgpt text={project.title} /></h3>
              </div>
              <p><InlineTextByCgpt text={project.description} /></p>
            </article>
          ))}
        </div>
      </section>

      <section id="work-experience" class="content-section" aria-labelledby="experience-title">
        <div class="section-heading compact">
          <div>
            <h2 id="experience-title">💼 Work Experience</h2>
          </div>
        </div>

        <div class="timeline">
          {
            workExperience.map((experience) => (
              <article class:list={["timeline-item", experience.placeholder && "is-placeholder"]}>
                <p class="timeline-period"><InlineTextByCgpt text={experience.period} /></p>
                <div>
                  <h3 class="timeline-organization">
                    <OrganizationName name={experience.organization} />
                  </h3>
                  <p class="timeline-role"><InlineTextByCgpt text={experience.role} /></p>
                  <p><InlineTextByCgpt text={experience.descriptionHtml ?? experience.description} html={Boolean(experience.descriptionHtml)} /></p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="educations" class="content-section" aria-labelledby="education-title">
        <div class="section-heading compact">
          <div><h2 id="education-title">📖 Educations</h2></div>
        </div>
        <div class="timeline">
          {education.map((experience) => (
            <article class="timeline-item">
              <p class="timeline-period"><InlineTextByCgpt text={experience.period} /></p>
              <div>
                <h3 class="education-heading">
                  <OrganizationName name={experience.organization} />
                </h3>
                <p class="timeline-role"><InlineTextByCgpt text={experience.role} /></p>
                <p><InlineTextByCgpt text={experience.descriptionHtml ?? experience.description} html={Boolean(experience.descriptionHtml)} /></p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <AwardsSectionByCgpt kind="honors" />

      <footer class="site-footer">
        <p><InlineTextByCgpt text="Zhiyuan Chen · Last updated 2026" /></p>
        <a href="#about-me">Back to top</a>
        <small class="template-attribution">
          Theme adapted from <a href="https://themes.3rdwavemedia.com/" target="_blank" rel="noopener noreferrer">Developer by Xiaoying Riley / 3rd Wave Media</a>.
        </small>
      </footer>
    </div>
  </main>
</BaseLayout>
